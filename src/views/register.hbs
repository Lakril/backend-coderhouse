<h1>{{title}}</h1>
<form>
    <label for='name'>Nombre</label>
    <input id='name' name='name' type='text' autocomplete='on' placeholder='name' /><br />
    <label for='lastname'>Apellido</label>
    <input id='lastname' name='lastname' type='text' autocomplete='on' placeholder='lastname' /><br />
    <label for='email'>Email</label>
    <input id='email' name='email' type='email' autocomplete='on' placeholder='email' /><br />
    <label for='username'>User name</label>
    <input id='username' name='username' type='text' autocomplete='on' placeholder='username' /><br />
    <label for='password'>Password</label>
    <input id='password' name='password' type='password' placeholder='password' autocomplete='on' /><br />
    <br />
    <div>
        <button type='submit'>register!</button>
    </div>
</form>
<script src='/public/js/register.js'></script>